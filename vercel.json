{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm install && npm run build",
  "installCommand": "npm install --prefix backend && npm install --prefix frontend",
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/index" },
    { "source": "/emails/:path*", "destination": "/api/index" },
    { "source": "/slack/:path*", "destination": "/api/index" },
    { "source": "/admin/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ]
}
